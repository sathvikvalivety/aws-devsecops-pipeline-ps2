# REMEDIATED CONTAINER SPECIFICATION
# FOR DEVSECOPS SECURITY GATE TESTING
FROM python:3.11-slim-bookworm AS builder

WORKDIR /build
COPY requirements-secure.txt .
RUN pip install --no-cache-dir --user -r requirements-secure.txt

FROM python:3.11-slim-bookworm AS runtime

RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /sbin/nologin -M appuser

WORKDIR /app
COPY --from=builder /root/.local /home/appuser/.local
ENV PATH="/home/appuser/.local/bin:${PATH}"

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "print('Healthy')" || exit 1

CMD ["python", "-c", "print('Secure container running as non-root UID 10001')"]
